# Server configuration
PORT=3000
NODE_ENV=development

# MongoDB — local fallback
MONGODB_URI=mongodb://localhost:27017/media_library

# MongoDB Atlas — non-SRV form to avoid DNS lookup issues on restricted networks.
# When set, this takes precedence over MONGODB_URI.
MONGODB_ATLAS_URI=

# File upload configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
